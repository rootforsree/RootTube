<?xml version="1.0" encoding="utf-8"?>
<!-- RootTube glass focus: glass panel with a red focus ring for
     focused controls. Base layer is the accent ring; the glass
     panel sits 2dp inside it, so the ring reads from across
     the room. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/roottube_accent" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/roottube_glass_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/roottube_glass_border" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/roottube_glass_highlight"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.2"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
