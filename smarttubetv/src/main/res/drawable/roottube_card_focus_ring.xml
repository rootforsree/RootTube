<?xml version="1.0" encoding="utf-8"?>
<!-- RootTube focus ring for browse cards: red rounded stroke, drawn as the
     card foreground on selection (API 23+). Color comes from the shared
     theme token, never a hardcoded hex. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/roottube_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
