<?xml version="1.0" encoding="utf-8"?>
<!--
    RootTube player seek focus ring. Drawn behind the custom SeekBar view
    (lb_playback_transport_controls_row.xml). The SeekBar paints its own
    red bar and white knob; this selector only adds the focus treatment
    the glass theme needs: a thick red ring around the whole bar track
    while it has D-pad focus, invisible otherwise. No new colors: the
    ring reuses the existing red token.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/red" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
