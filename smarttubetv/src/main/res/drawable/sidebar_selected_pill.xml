<?xml version="1.0" encoding="utf-8"?>
<!-- RootTube v2.2 sidebar selected pill: glass body with a red accent edge
     on the left. Applied as the header row background; its alpha is driven
     by the Leanback select level (0 = unselected/invisible, 1 = selected). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Red accent edge, left side only -->
    <item android:gravity="left|center_vertical">
        <shape android:shape="rectangle">
            <size android:width="4dp" />
            <solid android:color="@color/roottube_accent" />
            <corners
                android:topLeftRadius="32dp"
                android:bottomLeftRadius="32dp" />
        </shape>
    </item>
    <!-- Glass body, inset past the red edge -->
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/roottube_glass_fill_strong" />
            <stroke
                android:width="1dp"
                android:color="@color/roottube_glass_border" />
            <corners
                android:topRightRadius="32dp"
                android:bottomRightRadius="32dp" />
        </shape>
    </item>
</layer-list>
