<?xml version="1.0" encoding="utf-8"?>
<!-- RootTube glass panel: translucent fill, 1dp hairline border,
     specular highlight fading down from the top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/roottube_glass_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/roottube_glass_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/roottube_glass_highlight"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.2"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
